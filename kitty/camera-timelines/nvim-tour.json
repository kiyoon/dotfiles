{
  "version": 1,
  "steps": [
    {
      "op": "camera_begin",
      "lease": 30,
      "cancel_on_input": false
    },
    {
      "op": "camera_to",
      "zoom": 1.5,
      "x": "center",
      "y": 0.3333333333333333,
      "tilt_x": 2.0,
      "tilt_y": -1.0,
      "duration": 0,
      "easing": "smoothstep"
    },
    {
      "op": "camera_to",
      "zoom": 1.5,
      "x": "center",
      "y": 0.6666666666666666,
      "tilt_x": -2.0,
      "tilt_y": 1.0,
      "duration": 1.0,
      "easing": "smoothstep",
      "await": true
    },
    {
      "op": "camera_restore",
      "target": "rest",
      "duration": 0.8,
      "easing": "smoothstep"
    }
  ]
}
