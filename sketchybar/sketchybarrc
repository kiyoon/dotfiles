#!/usr/bin/env bash
# SketchyBar config, integrated with AeroSpace (see aerospace/aerospace.toml
# exec-on-workspace-change). Workspaces here are dynamic: items space.1..30 are
# pre-created hidden and toggled by plugins/aerospace_workspaces.sh.

source "$CONFIG_DIR/colors.sh"
PLUGIN_DIR="$CONFIG_DIR/plugins"

FONT="JetBrainsMono Nerd Font"

# Compiled helpers (committed as .swift, binary gitignored, built on demand).
HELPER_DIR="$CONFIG_DIR/helpers"
[[ -x "$HELPER_DIR/tis_current" ]] || \
	swiftc -O "$HELPER_DIR/tis_current.swift" -o "$HELPER_DIR/tis_current" 2>/dev/null
[[ -x "$HELPER_DIR/codexbar_usage_watcher" && \
	"$HELPER_DIR/codexbar_usage_watcher" -nt "$HELPER_DIR/codexbar_usage_watcher.swift" ]] || \
	swiftc -O "$HELPER_DIR/codexbar_usage_watcher.swift" \
		-o "$HELPER_DIR/codexbar_usage_watcher" -framework AppKit 2>/dev/null
[[ -x "$HELPER_DIR/battery_charge_limit" && \
	"$HELPER_DIR/battery_charge_limit" -nt "$HELPER_DIR/battery_charge_limit.m" ]] || \
	clang -O2 -fobjc-arc -Wall -Wextra \
		"$HELPER_DIR/battery_charge_limit.m" -framework Foundation \
		-o "$HELPER_DIR/battery_charge_limit" 2>/dev/null

# ---- Bar ----
sketchybar --bar \
	position=top \
	height=36 \
	display=all \
	sticky=on \
	padding_left=10 \
	padding_right=4 \
	blur_radius=20 \
	color=$BAR_COLOR

# ---- Defaults ----
sketchybar --default \
	padding_left=4 \
	padding_right=4 \
	icon.font="$FONT:Bold:13.0" \
	icon.color=$LABEL_COLOR \
	icon.padding_left=8 \
	icon.padding_right=4 \
	label.font="$FONT:Medium:12.0" \
	label.color=$LABEL_COLOR \
	label.padding_left=2 \
	label.padding_right=8 \
	background.color=$ITEM_BG_COLOR \
	background.corner_radius=6 \
	background.height=24 \
	background.drawing=off

# ---- Transient gaming-stop status ----
# The destructive action lives in the Hammerspoon reload/restart menu. Keep a
# permanently hidden, label-only item first in the left-side order so progress
# and the final result can appear briefly at the absolute left edge.
sketchybar --add item gaming_stop left \
	--set gaming_stop \
	drawing=off \
	width=150 \
	icon=󰊴 \
	icon.drawing=off \
	label.drawing=off \
	label.font="$FONT:Bold:11.0" \
	label.padding_left=6 \
	label.padding_right=6 \
	background.drawing=on

# ---- Hammerspoon native menus ----
# These are plain SketchyBar buttons. The popups are hidden hs.menubar objects
# opened by Hammerspoon, not SketchyBar popup menus.
sketchybar --add item hs_reload_menu left \
	--set hs_reload_menu \
	icon=󰜉 \
	icon.color=$LABEL_COLOR \
	label.drawing=off \
	padding_left=2 \
	padding_right=2 \
	click_script="$PLUGIN_DIR/hammerspoon_menu_click.sh reload"

sketchybar --add item hs_prompts_menu left \
	--set hs_prompts_menu \
	icon=󰚩 \
	icon.color=$LABEL_COLOR \
	label.drawing=off \
	padding_left=2 \
	padding_right=2 \
	click_script="$PLUGIN_DIR/hammerspoon_menu_click.sh prompts"

sketchybar --add item hs_displays_menu left \
	--set hs_displays_menu \
	icon=󰍺 \
	icon.color=$LABEL_COLOR \
	label.drawing=off \
	padding_left=2 \
	padding_right=2 \
	click_script="$PLUGIN_DIR/hammerspoon_menu_click.sh displays"

# ---- AeroSpace mode badge (left of workspaces, hidden in main mode) ----
# Fired by the mode-switching keybindings in aerospace.toml.
sketchybar --add event aerospace_mode_change

sketchybar --add item aero_mode left \
	--set aero_mode \
	drawing=off \
	updates=on \
	icon.drawing=off \
	label.font="$FONT:Bold:11.0" \
	label.padding_left=8 \
	label.padding_right=8 \
	background.drawing=on \
	script="$PLUGIN_DIR/mode.sh" \
	--subscribe aero_mode aerospace_mode_change forced

# ---- AeroSpace workspaces (left) ----
# Fired by aerospace's exec-on-workspace-change.
sketchybar --add event aerospace_workspace_change
# Distinct readiness event fired by AeroSpace after its startup refresh.
sketchybar --add event aerospace_started

# Pre-create all 30 possible workspace items hidden; the listener plugin
# toggles drawing + highlight. No add/remove churn -> stable order, no flicker.
space_args=()
for sid in $(seq 1 30); do
	space_args+=(
		--add item "space.$sid" left
		--set "space.$sid"
		drawing=off
		icon="$sid"
		icon.padding_left=9
		icon.padding_right=4
		label.drawing=off
		label.font="sketchybar-app-font:Regular:15.0"
		label.padding_left=0
		label.padding_right=9
		background.drawing=on
		click_script="/opt/homebrew/bin/aerospace workspace $sid"
	)
done
sketchybar "${space_args[@]}"

# Thin separators between per-monitor workspace groups (multi-monitor only).
# The listener's --reorder positions them; single monitor keeps them hidden.
divider_args=()
for d in 1 2 3; do
	divider_args+=(
		--add item "divider.$d" left
		--set "divider.$d"
		drawing=off
		icon="│"
		icon.color=$MUTED_COLOR
		icon.padding_left=2
		icon.padding_right=2
		label.drawing=off
	)
done
sketchybar "${divider_args[@]}"

# Hidden listener that rebuilds workspace visibility on every change.
# updates=on so it keeps receiving events while drawing=off.
sketchybar --add item aerospace_listener left \
	--set aerospace_listener \
	drawing=off \
	updates=on \
	script="$PLUGIN_DIR/aerospace_workspaces.sh" \
	--subscribe aerospace_listener aerospace_workspace_change aerospace_started forced \
	system_woke display_change space_windows_change

# ---- Front app (left) ----
sketchybar --add item front_app left \
	--set front_app \
	icon.drawing=off \
	label.font="$FONT:Bold:12.0" \
	label.padding_left=8 \
	script="$PLUGIN_DIR/front_app.sh" \
	--subscribe front_app front_app_switched forced

# ---- Right side: clock | battery | charge limit | volume | bluetooth | wifi ----
# Keep right-side outer gaps at zero so the complete group stays to the right
# of the MacBook notch. Internal icon/label padding preserves click targets.
compact=(
	padding_left=0 padding_right=0
	icon.padding_left=4 icon.padding_right=2
	label.padding_left=2 label.padding_right=4
)

sketchybar --add item clock right \
	--set clock \
	padding_left=0 \
	padding_right=0 \
	update_freq=10 \
	icon=󰃰 \
	background.drawing=on \
	click_script="open -a Calendar" \
	script="$PLUGIN_DIR/clock.sh"

# macOS 26.4+ native maximum-charge policy. Clicks trigger the custom event;
# the poll picks up changes made separately in System Settings. PowerUI's own
# change signal is Darwin-only, while SketchyBar maps distributed notifications.
# Right-position items render in reverse declaration order, so declare the blue
# cap suffix first and the current charge second to display: icon 74≤80%.
sketchybar --add event battery_limit_change

sketchybar --add item battery_limit right \
	--set battery_limit \
	"${compact[@]}" \
	icon.drawing=off \
	label.padding_left=0 \
	click_script="$PLUGIN_DIR/battery_limit_click.sh"

sketchybar --add item battery right \
	--set battery \
	"${compact[@]}" \
	label.padding_right=0 \
	update_freq=30 \
	click_script="open 'x-apple.systempreferences:com.apple.Battery-Settings.extension'" \
	script="$PLUGIN_DIR/battery.sh" \
	--subscribe battery battery_limit_change power_source_change system_woke forced

sketchybar --add item volume right \
	--set volume \
	"${compact[@]}" \
	click_script="$PLUGIN_DIR/volume_click.sh" \
	script="$PLUGIN_DIR/volume.sh" \
	--subscribe volume volume_change forced

sketchybar --add event bluetooth_change "com.apple.bluetooth.status" \
	--add event bluetooth_on "IOBluetoothHostControllerPoweredOnNotification" \
	--add event bluetooth_off "IOBluetoothHostControllerPoweredOffNotification" \
	--add event bluetooth_boucles_change

sketchybar --add item bluetooth_boucles right \
	--set bluetooth_boucles \
	"${compact[@]}" \
	click_script="$PLUGIN_DIR/bluetooth_click.sh" \
	script="$PLUGIN_DIR/bluetooth_boucles.sh" \
	--subscribe bluetooth_boucles bluetooth_boucles_change bluetooth_change bluetooth_on bluetooth_off system_woke forced

killall bluetooth_boucles_watcher 2>/dev/null
[[ -x "$HELPER_DIR/bluetooth_boucles_watcher" ]] || \
	swiftc -O "$HELPER_DIR/bluetooth_boucles_watcher.swift" -o "$HELPER_DIR/bluetooth_boucles_watcher" -framework IOBluetooth 2>/dev/null
"$HELPER_DIR/bluetooth_boucles_watcher" &

sketchybar --add item wifi right \
	--set wifi \
	"${compact[@]}" \
	update_freq=30 \
	click_script="$PLUGIN_DIR/wifi_click.sh" \
	script="$PLUGIN_DIR/wifi.sh" \
	--subscribe wifi wifi_change system_woke

# ---- System stats: cpu | gpu | ram (left of wifi) ----
# Right-position items stack right-to-left, so add order here is reversed.
sketchybar --add item ram right \
	--set ram \
	"${compact[@]}" \
	update_freq=10 \
	icon=󰍛 \
	icon.color=$MUTED_COLOR \
	click_script="open -a 'Activity Monitor'" \
	script="$PLUGIN_DIR/ram.sh"

sketchybar --add item gpu right \
	--set gpu \
	"${compact[@]}" \
	update_freq=5 \
	icon=󰢮 \
	icon.color=$MUTED_COLOR \
	click_script="open -a 'Activity Monitor'" \
	script="$PLUGIN_DIR/gpu.sh"

sketchybar --add item cpu right \
	--set cpu \
	"${compact[@]}" \
	update_freq=5 \
	icon=󰘚 \
	icon.color=$MUTED_COLOR \
	click_script="open -a 'Activity Monitor'" \
	script="$PLUGIN_DIR/cpu.sh"

# ---- Built-in macOS screen recording stop ----
sketchybar --add event recording_check

sketchybar --add item recording_stop right \
	--set recording_stop \
	"${compact[@]}" \
	drawing=off \
	update_freq=2 \
	icon=󰓛 \
	icon.color=$RED \
	click_script="$PLUGIN_DIR/recording_stop_click.sh" \
	script="$PLUGIN_DIR/recording_stop.sh" \
	--subscribe recording_stop recording_check forced

# Input method (한/A): native item, deliberately NOT an alias. macOS draws
# the input icon in different windows per source type (method vs layout), only
# the active display's copy renders, and the plain-layout window is anonymous
# with a drifting identity -- no capture survives a source switch (verified by
# pixel-probing). Event-driven via helpers/input_watcher: the OS's own
# input-switch distributed notifications no longer fire on this macOS (tested
# with real switches), so the watcher daemon polls the TIS API in-process at
# 150ms (negligible CPU, no process spawns) and triggers input_change only on
# actual changes, passing INPUT_SOURCE_ID. update_freq is just a safety net.
# Drawn as a pill so it is big enough to click; clicking pops the real
# menu bar dropdown.
sketchybar --add event input_change

sketchybar --add item input_method right \
	--set input_method \
	padding_left=0 \
	padding_right=0 \
	update_freq=60 \
	icon.drawing=off \
	label.font="$FONT:Bold:13.0" \
	label.padding_left=7 \
	label.padding_right=7 \
	background.drawing=on \
	click_script="$PLUGIN_DIR/alias_click.sh TextInputMenuAgent input" \
	script="$PLUGIN_DIR/input_source.sh" \
	--subscribe input_method input_change

killall input_watcher 2>/dev/null
[[ -x "$HELPER_DIR/input_watcher" ]] || \
	swiftc -O "$HELPER_DIR/input_watcher.swift" -o "$HELPER_DIR/input_watcher" 2>/dev/null
"$HELPER_DIR/input_watcher" &

# ---- Amphetamine (native item; no screen capture) ----
# Its AppleScript dictionary exposes the session state directly. The click
# handler triggers an immediate refresh; the slow poll catches sessions changed
# from Amphetamine itself and timed/Trigger sessions ending on their own.
sketchybar --add event amphetamine_change

sketchybar --add item amphetamine right \
	--set amphetamine \
	"${compact[@]}" \
	update_freq=30 \
	icon=󰒲 \
	icon.color=$MUTED_COLOR \
	label.drawing=off \
	click_script="$PLUGIN_DIR/amphetamine_click.sh" \
	script="$PLUGIN_DIR/amphetamine.sh" \
	--subscribe amphetamine amphetamine_change system_woke forced

# ---- CodexBar usage ----
# Default: two zero-capture items rendered from CodexBar's cached widget data.
# Fallback: uncomment the next line if CodexBar changes its cache schema and you
# want its live merged menu-bar item instead. Alias mode needs Screen Recording
# permission and can make macOS show the recording indicator again.
CODEXBAR_DISPLAY_MODE="${CODEXBAR_DISPLAY_MODE:-native}"
# CODEXBAR_DISPLAY_MODE=alias

killall codexbar_usage_watcher 2>/dev/null
if [[ "$CODEXBAR_DISPLAY_MODE" == alias ]]; then
	"$PLUGIN_DIR/optional_aliases.sh"
else
	# The helper watches CodexBar's WidgetKit snapshot directory, renders one
	# plain merged-style two-lane meter per provider, and never calls its
	# fetching CLI. Add Claude first because right-position items stack
	# right-to-left: the visible order is Codex | Claude | Amphetamine.
	codexbar_usage_item=(
		padding_left=0 padding_right=0
		icon="" icon.width=18
		icon.padding_left=2 icon.padding_right=2
		icon.background.drawing=on
		icon.background.color=0x00000000
		icon.background.height=18
		icon.background.image.scale=0.5
		icon.background.image.drawing=on
		label.drawing=off
		background.drawing=off
		click_script="$PLUGIN_DIR/codexbar_click.sh"
	)

	sketchybar --add item claude_usage right \
		--set claude_usage \
		drawing=off \
		"${codexbar_usage_item[@]}"

	sketchybar --add item codex_usage right \
		--set codex_usage \
		drawing=off \
		"${codexbar_usage_item[@]}"

	# The watcher also fills the Codex meter's otherwise empty bottom lane with
	# this Mac's share of the weekly window: it runs helpers/codex_local_usage.py
	# only when Codex appends to a rollout (FSEvents), never on a timer.
	if [[ -x "$HELPER_DIR/codexbar_usage_watcher" ]]; then
		SKETCHYBAR_PID="$PPID" \
			CODEXBAR_USAGE_COLOR="$LABEL_COLOR" \
			"$HELPER_DIR/codexbar_usage_watcher" >/dev/null 2>&1 &
	fi
fi

# ---- Finalize ----
sketchybar --update
